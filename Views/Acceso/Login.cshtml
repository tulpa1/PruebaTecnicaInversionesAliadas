@model PruebaTecnicaInversionesAliadas.Models.Usuario;

@{
    Layout = null;
}

<thml>
    <head>
        <title>Acceso</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    </head>

    <body>
        <div class="row mt-5 justify-content-center">
            <div class="col-sm-4">
                <div class="card">
                    <div class="card-header">
                        <h3>Acceso</h3>
                    </div>

                    <div class="card-body">
                        <form asp-controller="Acceso" asp-action="Login" method="post">

                            <input class="form-control mb-3" type="text" placeholder="Correo"
                                   asp-for="Correo" required />

                            <input class="form-control mb-3" type="password" placeholder="Contraseña"
                                   asp-for="Clave" required />

                            <div class="d-grid gap-2 mb-3">
                                <button class="btn btn-primary" type="submit">Inicia Sesion</button>
                            </div>

                            @if (ViewData["mensaje"] != null)
                            {
                                <div class="alert alert-danger" role="alert">
                                    @ViewData["mensaje"]
                                </div>
                            }

                            No tienes una cuenta? <a asp-controller="Acceso" asp-action="Registrarse">Registrarse</a>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    </body>

</thml>